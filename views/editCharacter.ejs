<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Character</title>

    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🦉</text></svg>">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@700&display=swap" rel="stylesheet">
    <style> .navbar-brand, h1 { font-family: 'Cinzel Decorative', cursive; } </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="/characters">🦉 Hogwarts Registry</a>
            <a href="/auth/logout" class="btn btn-outline-light">Logout</a>
        </div>
    </nav>
    <div class="container mt-5">
        <h1 class="mb-4">Edit <%= character.name %></h1>
        <form action="/characters/update/<%= character._id %>" method="POST">
            <div class="mb-3">
                <label for="name" class="form-label">Name:</label>
                <input type="text" id="name" name="name" class="form-control" value="<%= character.name %>" required>
            </div>
            <div class="mb-3">
                <label for="house" class="form-label">House:</label>
                <input type="text" id="house" name="house" class="form-control" value="<%= character.house %>">
            </div>
            <div class="mb-3">
                <label for="wand" class="form-label">Wand:</label>
                <input type="text" id="wand" name="wand" class="form-control" value="<%= character.wand %>">
            </div>
            <button type="submit" class="btn btn-warning">🪄 Update Character</button>
            <a href="/characters" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</body>
</html>